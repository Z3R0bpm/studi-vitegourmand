generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model opening_hours {
  id           Int    @id @default(autoincrement())
  day          String @db.VarChar(50)
  opening_time String @db.VarChar(50)
  closing_time String @db.VarChar(50)
}

model allergens {
  id               Int                @id @default(autoincrement())
  label            String             @db.VarChar(50)
  dishes_allergens dishes_allergens[]
}

model diets {
  id    Int     @id @default(autoincrement())
  label String  @db.VarChar(50)
  menus menus[]
}

model dishes {
  id               Int                @id @default(autoincrement())
  title            String             @db.VarChar(50)
  dish_type        String             @default("main") @db.VarChar(50)
  picture          Bytes?             @db.MediumBlob
  dishes_allergens dishes_allergens[]
  menus_dishes     menus_dishes[]
}

model dishes_allergens {
  dish_id     Int
  allergen_id Int
  allergens   allergens @relation(fields: [allergen_id], references: [id], onDelete: Cascade, map: "fk_dishes_allergens_allergen")
  dishes      dishes    @relation(fields: [dish_id], references: [id], onDelete: Cascade, map: "fk_dishes_allergens_dish")

  @@id([dish_id, allergen_id])
  @@index([allergen_id], map: "idx_dishes_allergens_allergen_id")
}

model menus {
  id               Int            @id @default(autoincrement())
  title            String         @db.VarChar(50)
  min_group_size   Int            @default(1)
  price_per_person Float
  description      String?        @db.VarChar(255)
  available        Int?
  theme_id         Int
  diet_id          Int
  diets            diets          @relation(fields: [diet_id], references: [id], map: "fk_menus_diet")
  themes           themes         @relation(fields: [theme_id], references: [id], map: "fk_menus_theme")
  menus_dishes     menus_dishes[]
  orders_menus     orders_menus[]

  @@index([diet_id], map: "idx_menus_diet_id")
  @@index([theme_id], map: "idx_menus_theme_id")
}

model menus_dishes {
  menu_id Int
  dish_id Int
  dishes  dishes @relation(fields: [dish_id], references: [id], onDelete: Cascade, map: "fk_menus_dishes_dish")
  menus   menus  @relation(fields: [menu_id], references: [id], onDelete: Cascade, map: "fk_menus_dishes_menu")

  @@id([menu_id, dish_id])
  @@index([dish_id], map: "idx_menus_dishes_dish_id")
}

model orders {
  id                Int            @id @default(autoincrement())
  order_date        DateTime       @db.Date
  delivery_date     DateTime       @db.Date
  delivery_time     String         @db.VarChar(50)
  order_price       Float
  group_size        Int
  delivery_price    Float
  status            String         @default("On hold") @db.VarChar(50)
  equipment_lending Boolean        @default(false)
  equipment_return  Boolean        @default(false)
  user_id           Int
  users             users          @relation(fields: [user_id], references: [id], map: "fk_orders_user")
  orders_menus      orders_menus[]

  @@index([user_id], map: "idx_orders_user_id")
}

model orders_menus {
  order_id Int
  menu_id  Int
  menus    menus  @relation(fields: [menu_id], references: [id], onDelete: Cascade, map: "fk_orders_menus_menu")
  orders   orders @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_orders_menus_order")

  @@id([order_id, menu_id])
  @@index([menu_id], map: "idx_orders_menus_menu_id")
}

model reviews {
  id          Int    @id @default(autoincrement())
  score       Int
  description String @db.VarChar(255)
  status      String @db.VarChar(50)
  user_id     Int
  users       users  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_reviews_user")

  @@index([user_id], map: "fk_reviews_user")
}

model roles {
  id    Int     @id
  label String  @db.VarChar(50)
  users users[]
}

model themes {
  id    Int     @id @default(autoincrement())
  label String  @db.VarChar(50)
  menus menus[]
}

model users {
  id        Int       @id @default(autoincrement())
  email     String    @unique(map: "email") @db.VarChar(255)
  password  String    @db.VarChar(60)
  phone     String?   @db.VarChar(50)
  city      String?   @db.VarChar(50)
  country   String?   @db.VarChar(50)
  address   String?   @db.VarChar(50)
  role_id   Int
  firstname String    @db.VarChar(50)
  lastname  String    @db.VarChar(50)
  orders    orders[]
  reviews   reviews[]
  roles     roles     @relation(fields: [role_id], references: [id], map: "fk_users_role")

  @@index([role_id], map: "fk_users_role")
}
